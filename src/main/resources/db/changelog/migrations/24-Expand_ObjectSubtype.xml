<?xml version="1.1" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://local.xsd/dbchangelog-4.4.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

  <changeSet id="24-Expand_ObjectSubtype" context="schema-change" author="cgendreau">
      <addColumn tableName="object_subtype">
        <column name="system_defined" type="BOOLEAN" defaultValueBoolean="false">
          <constraints nullable="false"/>
        </column>
        <column name="multilingual_title" type="jsonb"/>
        <column name="multilingual_description" type="jsonb"/>
      </addColumn>
  </changeSet>
</databaseChangeLog>
