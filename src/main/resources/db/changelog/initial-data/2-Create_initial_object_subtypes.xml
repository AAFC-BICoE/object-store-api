<?xml version="1.1" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://local.xsd/dbchangelog-4.4.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2-Create_initial_object_subtypes" context="initial-data" author="cgendreau">
        <update tableName="object_subtype">
            <column name="dc_type" value="DATASET"/>
            <column name="uuid" value="9b654ec8-a689-4ca3-9e60-9c25fbed9529"/>
            <column name="system_defined" value="true"/>
            <column name="multilingual_title" value='{"titles":[{"lang":"en","title":"Import Template"},{"lang":"fr","title":"Gabarit d&apos;import"}]}'/>
            <column name="created_by" value="system"/>
            <where>ac_subtype = 'IMPORT TEMPLATE'</where>
        </update>
        <update tableName="object_subtype">
            <column name="dc_type" value="DATASET"/>
            <column name="uuid" value="e2389fdf-efaf-47d5-a7d8-cd346c207760"/>
            <column name="system_defined" value="true"/>
            <column name="multilingual_title" value='{"titles":[{"lang":"en","title":"Export Template"},{"lang":"fr","title":"Gabarit d&apos;exportation"}]}'/>
            <column name="created_by" value="system"/>
            <where>ac_subtype = 'EXPORT TEMPLATE'</where>
        </update>
        <insert tableName="object_subtype">
            <column name="dc_type" value="DATASET"/>
            <column name="uuid" value="bc72b019-5ec5-4f92-bf56-5240a7dc7db4"/>
            <column name="ac_subtype" value="EXPORT PACKAGE"/>
            <column name="system_defined" value="true"/>
            <column name="multilingual_title" value='{"titles":[{"lang":"en","title":"Export Package"},{"lang":"fr","title":"Ensemble de données d&apos;exportation"}]}'/>
            <column name="created_by" value="system"/>
        </insert>
    </changeSet>

    <changeSet id="2_1-Insert_import_template_if_missing" context="initial-data" author="cgendreau">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM object_subtype WHERE ac_subtype = 'IMPORT TEMPLATE'</sqlCheck>
        </preConditions>
        <insert tableName="object_subtype">
            <column name="dc_type" value="DATASET"/>
            <column name="uuid" value="9b654ec8-a689-4ca3-9e60-9c25fbed9529"/>
            <column name="ac_subtype" value="IMPORT TEMPLATE"/>
            <column name="system_defined" value="true"/>
            <column name="multilingual_title" value='{"titles":[{"lang":"en","title":"Import Template"},{"lang":"fr","title":"Gabarit d&apos;import"}]}'/>
            <column name="created_by" value="system"/>
        </insert>
    </changeSet>

    <changeSet id="2_2-Insert_export_template_if_missing" context="initial-data" author="cgendreau">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM object_subtype WHERE ac_subtype = 'EXPORT TEMPLATE'</sqlCheck>
        </preConditions>
        <insert tableName="object_subtype">
            <column name="dc_type" value="DATASET"/>
            <column name="uuid" value="e2389fdf-efaf-47d5-a7d8-cd346c207760"/>
            <column name="ac_subtype" value="EXPORT TEMPLATE"/>
            <column name="system_defined" value="true"/>
            <column name="multilingual_title" value='{"titles":[{"lang":"en","title":"Export Template"},{"lang":"fr","title":"Gabarit d&apos;exportation"}]}'/>
            <column name="created_by" value="system"/>
        </insert>
    </changeSet>
</databaseChangeLog>
